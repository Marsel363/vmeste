# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
# sqlite for local use. For cloud deployment use a persistent PostgreSQL database.
DATABASE_URL=sqlite:///./vmeste.db
MGSU_SOURCE=auto
# auto: official PDF, dated local PDF fallback, then public alternative sources.
# Optional overrides: pdf, web (raspisanie-mgsu.ru), raspika, raspika_public.
# Optional key for the documented Raspika API; empty means public-week import
RASPIKA_API_KEY=
RASPIKA_INSTITUTION=mgsu
RASPIKA_GROUP_QUERY=ИПГС 2-64
MAI_GROUP=М3О-237БВ-25
# HTTPS deployments: 1; local http: 0
COOKIE_SECURE=0
# Comma-separated HTTPS origins (or localhost in local development)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_SCHEDULER=1
# 24h interval; lazy sync also occurs when opening the app
SYNC_INTERVAL_HOURS=24
# Only for docker-compose with PostgreSQL; generate a random password
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
